# URL publik utama. Tanpa slash di akhir.
NEXT_PUBLIC_SITE_URL=https://hybloggyon.vercel.app

# Opsional: token verifikasi Google Search Console (nilai meta tag saja).
GOOGLE_SITE_VERIFICATION=

# Opsional: dipakai oleh halaman Kurasi untuk mengambil poster TMDB.
NEXT_PUBLIC_TMDB_API_KEY=

# PostgreSQL untuk migration, seed, dan repository database.
DATABASE_URL=postgresql://user:password@host:5432/hybloggyon
DATABASE_SSL=require
DATABASE_POOL_MAX=1

# Jangan ubah ke database sebelum migrasi konten selesai diverifikasi.
CONTENT_SOURCE=markdown

# Bootstrap akun pemilik dengan `npm run admin:create`, lalu hapus password dari env.
ADMIN_EMAIL=owner@example.com
ADMIN_DISPLAY_NAME=Pemilik HyBloggyon
ADMIN_PASSWORD=ganti-dengan-password-minimal-12-karakter
ADMIN_SESSION_DAYS=30

# Upload gambar lokal cocok untuk development/self-hosted dengan disk persisten.
MEDIA_STORAGE=local
MEDIA_MAX_SIZE_MB=8

# Production: ubah MEDIA_STORAGE=s3 dan isi koneksi object storage S3-compatible.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Hanya untuk test E2E lokal/CI. Jangan isi dengan kredensial production.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
