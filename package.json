{
  "name": "hybloggyon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "content:check": "node scripts/validate-content.mjs",
    "content:import": "node scripts/import-markdown-to-database.mjs",
    "content:audit": "node scripts/audit-content-parity.mjs",
    "seo:check": "node scripts/audit-seo.mjs",
    "env:check": "node scripts/check-readiness.mjs",
    "env:check:production": "node scripts/check-readiness.mjs --production --require-database",
    "cutover:check": "npm run env:check:production && npm run db:migrations:check && npm run db:check && npm run content:audit && npm run seo:check && npm run lint && npm run build",
    "release:check": "npm run env:check:production && npm run db:migrations:check && npm run db:check && npm run seo:check && npm run lint && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrations:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-database.mjs",
    "db:check": "node scripts/check-database.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "start:e2e": "next start -p 3100",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:public": "node scripts/run-e2e.mjs tests/e2e/public.spec.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "split-type": "^0.3.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0"
  }
}
